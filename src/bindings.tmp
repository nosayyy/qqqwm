#include "common.h"

static bool keybind(uint32_t mods, xkb_keysym_t sym) {
	if (mods != cfg.modkey)
		return false;
	if (xkb_keysym_to_lower(sym) == xkb_keysym_to_lower(cfg.terminal_key)) {
		char *const argv[] = {(char *)cfg.terminal, NULL};
		spawn(&(Arg){.v = argv});
		return true;
	}
	if (xkb_keysym_to_lower(sym) == xkb_keysym_to_lower(cfg.kill_key)) {
		killclient(&(Arg){0});
		return true;
	}
	if (xkb_keysym_to_lower(sym) == xkb_keysym_to_lower(cfg.quit_key)) {
		quit(&(Arg){0});
		return true;
	}
	return false;
}
